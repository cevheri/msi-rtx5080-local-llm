        "input": [
          "text"
        ],
        "output": [
          "text"
        ],
        "reasoning": {
          "supported": true
        }
      },
      "limit": {
        "context": 65536,
        "output": 16384
      }
    },
    "gpt-oss-20b": {
      "modelID": "gpt-oss-20b",
