{
  "$schema": "https://opencode.ai/config.json",
  "model": "llamacpp-docker/gpt-oss-20b",
  "plugins": [
    "-opencode.provider.vllm"
  ],
  "mcp": {
    "libredb": {
      "enabled": false
    }
  },
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": "deny",
    "task": "deny",
    "external_directory": "deny",
    "webfetch": "deny",
    "websearch": "deny",
    "skill": "deny",
    "question": "deny"
  },
  "providers": {
    "llamacpp-docker": {
      "name": "llama.cpp (Docker)",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:8080/v1",
        "headerTimeout": 600000
      },
      "compatibility": {
        "reasoningField": "reasoning_content"
      },
      "models": {
        "gpt-oss-20b": {
          "modelID": "local",
          "name": "gpt-oss-20b MXFP4 (llama.cpp)",
          "capabilities": {
            "tools": true,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ],
            "reasoning": {
              "supported": true,
              "effort": [
                "low",
                "medium",
                "high"
              ]
            }
          },
          "limit": {
            "context": 131072,
            "output": 16384
          }
        },
        "qwen3.8-27b": {
          "modelID": "local",
          "name": "Qwen3.8-27B UD-Q3_K_XL (llama.cpp)",
          "capabilities": {
            "tools": true,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ],
            "reasoning": {
              "supported": true
            }
          },
          "limit": {
            "context": 65536,
            "output": 16384
          }
        },
        "qwen3.6-35b-a3b": {
          "modelID": "local",
          "name": "Qwen3.6-35B-A3B Q4_K_M (llama.cpp)",
          "capabilities": {
            "tools": true,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ],
            "reasoning": {
              "supported": true
            }
          },
          "limit": {
            "context": 131072,
            "output": 16384
          }
        }
      }
    },
    "vllm-docker": {
      "name": "vLLM (Docker)",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:8000/v1",
        "headerTimeout": 600000
      },
      "compatibility": {
        "reasoningField": "reasoning"
      },
      "models": {
        "gpt-oss-20b": {
          "modelID": "gpt-oss-20b",
          "name": "gpt-oss-20b (vLLM)",
          "capabilities": {
            "tools": true,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ],
            "reasoning": {
              "supported": true,
              "effort": [
                "low",
                "medium",
                "high"
              ]
            }
          },
          "limit": {
            "context": 65536,
            "output": 16384
          }
        }
      }
    }
  }
}