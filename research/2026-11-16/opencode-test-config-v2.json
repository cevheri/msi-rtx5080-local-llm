          "name": "DeepSeek-R1-0528-Qwen3-8B Q8_0 (llama.cpp, chat only)",
          "capabilities": {
            "tools": false,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ],
            "reasoning": {
              "supported": true
            }
          },
          "limit": {
            "context": 65536,
            "output": 32768
