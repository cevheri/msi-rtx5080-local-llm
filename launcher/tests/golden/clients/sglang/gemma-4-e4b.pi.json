          "reasoning": true,
          "input": [
            "text"
          ],
          "contextWindow": 65536,
          "maxTokens": 16384,
          "thinkingLevelMap": {
            "minimal": null,
            "low": null,
            "high": null
          },
          "compat": {
            "thinkingFormat": "chat-template",
            "chatTemplateKwargs": {
              "enable_thinking": {
                "$var": "thinking.enabled"
              }
            }
          }
        }
      ]
    }
  }
}
